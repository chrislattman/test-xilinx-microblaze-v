{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MicroBlaze-V Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/sw/hello_world/build/hello_world.elf",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerArgs": "-q",
            "customLaunchSetupCommands": [
                { "text": "set architecture riscv:rv32" },
                { "text": "file ${workspaceRoot}/sw/hello_world/build/hello_world.elf" },
                { "text": "target extended-remote localhost:3004" }
            ],
            "launchCompleteCommand": "None"
        },
        {
            "name": "Rust: MicroBlaze-V Debug",
            "type": "gdb",
            "request": "attach",
            "target": "extended-remote localhost:3004",
            "executable": "${workspaceFolder}/sw/target/riscv32i-unknown-none-elf/debug/hello-world-rs",
            "cwd": "${workspaceFolder}",
            "gdbpath": "${userHome}/.cargo/bin/rust-gdb",
            "env": {
                "RUST_GDB": "gdb-multiarch"
            },
            "stopAtConnect": true,
            "debugger_args": ["-iex", "python import gdb_load_rust_pretty_printers"],
            "autorun": [
                "set architecture riscv:rv32"
            ]
        }
    ]
}
