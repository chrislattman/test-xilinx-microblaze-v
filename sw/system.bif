//arch = zynq; split = false; format = BIN
// build/design_1_wrapper.bit is the bitstream with hello_world.elf in the MicroBlaze-V's
// BRAM (made by build.py with updatemem); the FSBL can't load the ELF itself.
the_ROM_image:
{
	[bootloader]/home/chris/test-xilinx-microblaze-v/sw/platform/export/platform/sw/boot/fsbl.elf
	/home/chris/test-xilinx-microblaze-v/sw/build/design_1_wrapper.bit
}
